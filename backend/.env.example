# Copy to .env and fill in. Never commit .env.

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Claude API key. With it, pasted links run the real pipeline; without it,
# every link returns the sample recipe.
ANTHROPIC_API_KEY=

# Only if your team routes Claude through a proxy or gateway: uncomment and set
# its URL. Leave it commented out to use Anthropic's API directly. Don't leave
# it uncommented and empty, or every Claude call fails.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com

# Optional overrides
# PIPELINE_MODE=stub          # force the sample recipe even with a key (stub | real)
# CLAUDE_MODEL=claude-opus-5-5
# WHISPER_MODEL=tiny          # faster-whisper size; still open, see docs/decisions.md #13
# EXTRACTION_CACHE=off        # reprocess every link instead of reusing results (e.g. while tuning prompts)
# CACHE_DB=.cache/extractions.sqlite3
# USAGE_LOG=.cache/usage.jsonl # one line per job: Claude calls, tokens, list-price estimate

# Seconds per simulated extraction stage (stub mode only)
STUB_STAGE_SECONDS=1.5

# Added as real stages land:
# USDA_API_KEY=
