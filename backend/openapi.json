{
  "openapi": "3.1.0",
  "info": {
    "title": "Breaking Bread API",
    "description": "Pasted TikTok/Reel link -> recipe -> grocery list, cost, macros, and guidance.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/recipes": {
      "post": {
        "summary": "Create Recipe",
        "description": "Start extraction from a link or pasted text. Poll the returned job.",
        "operationId": "create_recipe_api_recipes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecipeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/recipes/{recipe_id}": {
      "get": {
        "summary": "Get Recipe",
        "operationId": "get_recipe_api_recipes__recipe_id__get",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Recipe Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/recipes/{recipe_id}/plan": {
      "post": {
        "summary": "Plan Recipe",
        "operationId": "plan_recipe_api_recipes__recipe_id__plan_post",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Recipe Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MealPlan"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Costs": {
        "properties": {
          "trip_total": {
            "type": "number",
            "title": "Trip Total"
          },
          "per_meal": {
            "type": "number",
            "title": "Per Meal"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency",
            "default": "USD"
          },
          "approximate": {
            "type": "boolean",
            "const": true,
            "title": "Approximate",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "trip_total",
          "per_meal"
        ],
        "title": "Costs"
      },
      "CreateRecipeRequest": {
        "properties": {
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "type": "object",
        "title": "CreateRecipeRequest",
        "description": "Start extraction from a link, or from pasted caption/ingredient text."
      },
      "GroceryItem": {
        "properties": {
          "ingredient_id": {
            "type": "string",
            "title": "Ingredient Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "packages": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Packages",
            "description": "How many packages to buy"
          },
          "line_total": {
            "type": "number",
            "title": "Line Total",
            "description": "packages x package_price"
          }
        },
        "type": "object",
        "required": [
          "ingredient_id",
          "name",
          "product",
          "packages",
          "line_total"
        ],
        "title": "GroceryItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Ingredient": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "grams": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grams"
          },
          "estimated": {
            "type": "boolean",
            "title": "Estimated"
          },
          "source": {
            "type": "string",
            "enum": [
              "caption",
              "transcript",
              "frames",
              "pasted",
              "inferred"
            ],
            "title": "Source"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "owned": {
            "type": "boolean",
            "title": "Owned",
            "default": false
          },
          "product": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Product"
              },
              {
                "type": "null"
              }
            ]
          },
          "fdc_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fdc Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "estimated",
          "source",
          "confidence"
        ],
        "title": "Ingredient"
      },
      "Job": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/Stage"
            },
            "type": "array",
            "title": "Stages",
            "description": "Stages this job plans to run, in order"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stage"
              },
              {
                "type": "null"
              }
            ],
            "description": "Stage running now, or the one that failed"
          },
          "completed_stages": {
            "items": {
              "$ref": "#/components/schemas/Stage"
            },
            "type": "array",
            "title": "Completed Stages"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipe Id"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "stages",
          "stage",
          "completed_stages"
        ],
        "title": "Job"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "running",
          "done",
          "failed"
        ],
        "title": "JobStatus"
      },
      "Macros": {
        "properties": {
          "calories": {
            "type": "number",
            "title": "Calories"
          },
          "protein_g": {
            "type": "number",
            "title": "Protein G"
          },
          "carbs_g": {
            "type": "number",
            "title": "Carbs G"
          },
          "fat_g": {
            "type": "number",
            "title": "Fat G"
          },
          "approximate": {
            "type": "boolean",
            "title": "Approximate"
          }
        },
        "type": "object",
        "required": [
          "calories",
          "protein_g",
          "carbs_g",
          "fat_g",
          "approximate"
        ],
        "title": "Macros"
      },
      "MealPlan": {
        "properties": {
          "recipe_id": {
            "type": "string",
            "title": "Recipe Id"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "zip_code": {
            "type": "string",
            "title": "Zip Code"
          },
          "servings": {
            "$ref": "#/components/schemas/Servings"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            },
            "type": "array",
            "title": "Ingredients"
          },
          "grocery_list": {
            "items": {
              "$ref": "#/components/schemas/GroceryItem"
            },
            "type": "array",
            "title": "Grocery List"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array",
            "title": "Steps"
          },
          "costs": {
            "$ref": "#/components/schemas/Costs"
          },
          "macros_per_serving": {
            "$ref": "#/components/schemas/Macros"
          }
        },
        "type": "object",
        "required": [
          "recipe_id",
          "source_url",
          "title",
          "zip_code",
          "servings",
          "ingredients",
          "grocery_list",
          "steps",
          "costs",
          "macros_per_serving"
        ],
        "title": "MealPlan",
        "description": "Output of planning: the full results page for one recipe."
      },
      "PlanRequest": {
        "properties": {
          "zip_code": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "title": "Zip Code"
          },
          "owned_ingredient_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Owned Ingredient Ids",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "zip_code"
        ],
        "title": "PlanRequest"
      },
      "Product": {
        "properties": {
          "store_id": {
            "type": "string",
            "title": "Store Id"
          },
          "store_name": {
            "type": "string",
            "title": "Store Name"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "package_size_grams": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Package Size Grams"
          },
          "package_price": {
            "type": "number",
            "minimum": 0.0,
            "title": "Package Price"
          },
          "price_type": {
            "type": "string",
            "enum": [
              "store price",
              "estimate"
            ],
            "title": "Price Type"
          }
        },
        "type": "object",
        "required": [
          "store_id",
          "store_name",
          "product_name",
          "package_size_grams",
          "package_price",
          "price_type"
        ],
        "title": "Product"
      },
      "Recipe": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "creator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Creator"
          },
          "servings": {
            "$ref": "#/components/schemas/Servings"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            },
            "type": "array",
            "title": "Ingredients"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source_url",
          "title",
          "servings",
          "ingredients"
        ],
        "title": "Recipe",
        "description": "Output of extraction: what the reel says to cook."
      },
      "Servings": {
        "properties": {
          "value": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Value"
          },
          "estimated": {
            "type": "boolean",
            "title": "Estimated"
          }
        },
        "type": "object",
        "required": [
          "value",
          "estimated"
        ],
        "title": "Servings"
      },
      "Stage": {
        "type": "string",
        "enum": [
          "metadata",
          "audio",
          "frames",
          "merge"
        ],
        "title": "Stage",
        "description": "Extraction stages, in the order they run."
      },
      "Step": {
        "properties": {
          "order": {
            "type": "integer",
            "title": "Order"
          },
          "instruction": {
            "type": "string",
            "title": "Instruction"
          },
          "timer_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timer Seconds"
          },
          "doneness_cue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doneness Cue"
          },
          "safety_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safety Note"
          },
          "equipment_swap": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Equipment Swap"
          },
          "terms": {
            "items": {
              "$ref": "#/components/schemas/Term"
            },
            "type": "array",
            "title": "Terms",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "order",
          "instruction"
        ],
        "title": "Step"
      },
      "Term": {
        "properties": {
          "term": {
            "type": "string",
            "title": "Term"
          },
          "definition": {
            "type": "string",
            "title": "Definition"
          }
        },
        "type": "object",
        "required": [
          "term",
          "definition"
        ],
        "title": "Term"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
